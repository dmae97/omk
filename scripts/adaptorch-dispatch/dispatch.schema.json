{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omk.adaptorch.dispatch.v1",
  "title": "OMK AdaptOrch dispatch request",
  "description": "Either profile+budget (role plan via AEG-TE route_topologies) or subtasks (explicit DAG). Both may not be combined.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task"],
  "properties": {
    "schema": { "const": "omk.adaptorch.dispatch.v1" },
    "task": { "type": "string", "minLength": 1, "description": "Task text given to every node. Never put secrets here." },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": { "type": "string" },
        "repo_family": { "type": "string" },
        "task_type": { "type": "string" },
        "issue_terms": { "type": "array", "items": { "type": "string" } },
        "retrieved_files": { "type": "array", "items": { "type": "string" } },
        "difficulty": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_cost"],
      "properties": { "max_cost": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "templates": {
      "type": "array",
      "description": "Optional AEG-TE TopologyTemplate pool replacing default_topologies(). With the engine defaults the anchor template wins every round.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "roles"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["locator", "selector", "patcher", "strong_patcher", "strong_rewriter", "cross_reviewer", "apply_repairer"] }
          },
          "cost": { "type": "number" },
          "latency": { "type": "number" },
          "regression_risk": { "type": "number" },
          "expected_success": { "type": "number" },
          "apply_probability": { "type": "number" },
          "diversity_potential": { "type": "number" },
          "always_include": { "type": "boolean" }
        }
      }
    },
    "role_tokens": {
      "type": "object",
      "description": "Per-role estimated_tokens override (work proxy, not a real limit).",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "subtasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "estimated_tokens": { "type": "integer", "minimum": 1 },
          "role": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "coupling": { "type": ["number", "string"] }
        }
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_workers": { "type": "integer", "minimum": 1, "default": 4 },
        "max_in_flight_tokens": { "type": ["integer", "null"], "minimum": 1 },
        "priority": { "enum": ["critical_path", "fifo"], "default": "critical_path" },
        "timeout_s": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    }
  }
}

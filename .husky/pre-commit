#!/bin/sh

# Preserve the exact selection, including partially staged files.
STAGED_TREE=$(git write-tree) || exit 1

node scripts/check-lockfile-commit.mjs
if [ $? -ne 0 ]; then
  exit 1
fi

# Run the check script (formatting, linting, and type checking)
echo "Running formatting, linting, and type checking..."
npm run check
if [ $? -ne 0 ]; then
  echo "❌ Checks failed. Please fix the errors before committing."
  exit 1
fi

BROWSER_DIFF_STATUS=0
git diff --cached --quiet -- packages/ai packages/web-ui package.json package-lock.json || BROWSER_DIFF_STATUS=$?
if [ "$BROWSER_DIFF_STATUS" -gt 1 ]; then
  exit "$BROWSER_DIFF_STATUS"
fi
if [ "$BROWSER_DIFF_STATUS" -eq 1 ]; then
  echo "Running browser smoke check..."
  npm run check:browser-smoke
  if [ $? -ne 0 ]; then
    echo "❌ Browser smoke check failed."
    exit 1
  fi
fi

# Checks must not expand the user's selected commit. Do not auto-stage or restore.
CHECKED_TREE=$(git write-tree) || exit 1
if [ "$CHECKED_TREE" != "$STAGED_TREE" ]; then
  echo "❌ Staged index changed during checks. Review and stage the intended changes again." >&2
  exit 1
fi

echo "✅ All pre-commit checks passed!"

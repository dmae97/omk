{
	"name": "omk-book-to-skill",
	"version": "1.5.10",
	"description": "Optional OMK adapter for compiling documents into provenance-tracked agent skills",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"omk-book-to-skill": "dist/cli.js"
	},
	"files": [
		"dist",
		"skills",
		"vendor",
		"README.md",
		"LICENSE",
		"upstream.json",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "tsgo -p tsconfig.build.json && node -e \"const fs=require('node:fs');fs.chmodSync('dist/cli.js', fs.statSync('dist/cli.js').mode | 0o111)\"",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"omk",
		"omk-package",
		"agent-skills",
		"knowledge-compilation",
		"provenance"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dmae97/omk.git",
		"directory": "packages/book-to-skill"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"peerDependencies": {
		"open-multi-agent-kit": "*"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"open-multi-agent-kit": "^1.5.10",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	},
	"omk": {
		"extensions": [
			"./dist/extension.js"
		],
		"skills": [
			"./skills"
		]
	}
}

{
	"name": "open-multi-agent-kit",
	"version": "1.5.10",
	"description": "Open-source multi-agent coding CLI for the terminal (TypeScript, MIT). Switch models mid-session; finish goals only when your test passes.",
	"type": "module",
	"omkConfig": {
		"name": "omk",
		"configDir": ".omk"
	},
	"bin": {
		"omk": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./hooks": {
			"types": "./dist/core/hooks/index.d.ts",
			"import": "./dist/core/hooks/index.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"examples",
		"resources",
		"containerization.md",
		"CHANGELOG.md",
		"npm-shrinkwrap.json"
	],
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "node ./scripts/link-workspace-deps.mjs && tsgo -p tsconfig.build.json && node ../../scripts/prune-dist-orphans.mjs . && node ./scripts/copy-assets.mjs --chmod-cli && node ./scripts/copy-assets.mjs",
		"build:binary": "npm --prefix ../tui run build && npm --prefix ../ai run build && npm --prefix ../agent run build && npm run build && bun build --compile ./dist/bun/cli.js ./src/utils/image-resize-worker.ts --outfile dist/omk && node ./scripts/copy-assets.mjs --binary",
		"copy-assets": "node ./scripts/copy-assets.mjs",
		"copy-binary-assets": "node scripts/copy-assets.mjs --binary",
		"test": "vitest --run",
		"shrinkwrap": "node ../../scripts/generate-coding-agent-shrinkwrap.mjs",
		"prepublishOnly": "npm run clean && npm run build && npm run shrinkwrap",
		"link-workspace-deps": "node ./scripts/link-workspace-deps.mjs"
	},
	"dependencies": {
		"omk-agent-core": "^1.5.10",
		"omk-ai": "^1.5.10",
		"omk-tui": "^1.5.10",
		"@silvia-odwyer/photon-node": "0.3.4",
		"canonicalize": "4.0.0",
		"chalk": "5.6.2",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"glob": "13.0.6",
		"highlight.js": "10.7.3",
		"hosted-git-info": "9.0.3",
		"ignore": "7.0.6",
		"jiti": "2.7.0",
		"minimatch": "10.2.6",
		"proper-lockfile": "4.1.2",
		"typebox": "1.3.11",
		"undici": "8.12.3",
		"yaml": "2.9.0",
		"omk-adaptorch-wpl": "^1.5.10",
		"omk-protocol": "^1.5.10"
	},
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	},
	"optionalDependencies": {
		"@mariozechner/clipboard": "0.3.9"
	},
	"devDependencies": {
		"@types/cross-spawn": "6.0.6",
		"@types/hosted-git-info": "3.0.5",
		"@types/node": "24.12.4",
		"@types/proper-lockfile": "4.1.4",
		"fast-check": "4.9.0",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent",
		"multi-agent",
		"ai-agents",
		"coding-assistant",
		"terminal",
		"typescript",
		"mcp",
		"local-llm",
		"developer-tools",
		"ai-coding-agent",
		"claude-code-alternative",
		"coding-agent-cli",
		"open-source"
	],
	"author": "Geunbin Yu",
	"contributors": [
		"Mario Zechner"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dmae97/omk.git",
		"directory": "packages/coding-agent"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"homepage": "https://github.com/dmae97/omk#readme",
	"bugs": {
		"url": "https://github.com/dmae97/omk/issues"
	}
}
